{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowPublicReadStaticAndMedia",
      "Effect": "Allow",
      "Principal": "*",
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::totalliving-media-s3-prod-rm-us-east-1-001/static/*",
        "arn:aws:s3:::totalliving-media-s3-prod-rm-us-east-1-001/media/*"
      ]
    }
  ]
}
