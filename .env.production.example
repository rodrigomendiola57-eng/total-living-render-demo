# =========================
# Entorno de producción
# =========================
ENVIRONMENT=production
DJANGO_SETTINGS_MODULE=total_living.settings.production
DEBUG=False
APP_PORT=8090
SERVE_LOCAL_MEDIA=True

# =========================
# Seguridad Django
# =========================
SECRET_KEY=replace-with-a-very-long-random-secret
ALLOWED_HOSTS=example.com,www.example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com,http://localhost:8090,http://127.0.0.1:8090
ADMIN_URL_PATH=gestion-total-living-2026/
PANEL_URL_PATH=acceso-interno-staff-2026/
# Para pruebas locales en Docker usa False; en AWS + dominio cambia a True.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
ENFORCE_STRONG_SECRET_KEY=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# =========================
# Base de datos (Docker local / Lightsail)
# =========================
POSTGRES_DB=total_living
POSTGRES_USER=total_living
POSTGRES_PASSWORD=replace-with-strong-db-password
DATABASE_URL=postgresql://total_living:replace-with-strong-db-password@db:5432/total_living

# =========================
# AWS S3 (estáticos + media)
# =========================
USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name
AWS_S3_REGION_NAME=us-east-1
AWS_STATIC_LOCATION=static
AWS_MEDIA_LOCATION=media

# =========================
# Email SMTP
# =========================
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=replace-with-email-password
DEFAULT_FROM_EMAIL=no-reply@example.com

# =========================
# Rate limiting
# =========================
PANEL_LOGIN_RATELIMIT_IP=15/15m
PANEL_LOGIN_RATELIMIT_USERNAME=8/15m
CONTACT_FORM_RATELIMIT_IP=5/h

# =========================
# Gunicorn (rendimiento)
# =========================
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=90
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5

# =========================
# Mapa (opcional)
# =========================
MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO
MAP_TILE_SUBDOMAINS=abcd
MAP_TILE_MAX_ZOOM=20
