# Entorno
ENVIRONMENT=production
DJANGO_SETTINGS_MODULE=total_living.settings.production
DEBUG=False

# Seguridad Django
SECRET_KEY=replace-with-a-long-random-secret-key
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
ADMIN_URL_PATH=gestion-total-living-2026/
PANEL_URL_PATH=acceso-interno-staff-2026/
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Base de datos (PostgreSQL recomendado en produccion)
DATABASE_URL=postgresql://db_user:db_password@db-host:5432/db_name

# AWS S3 (estaticos y media)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name
AWS_S3_REGION_NAME=us-east-1

# Email SMTP
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=replace-with-email-password
DEFAULT_FROM_EMAIL=no-reply@example.com

# Rate limiting
PANEL_LOGIN_RATELIMIT_IP=15/15m
PANEL_LOGIN_RATELIMIT_USERNAME=8/15m
CONTACT_FORM_RATELIMIT_IP=5/h

# Mapa (opcional)
MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO
MAP_TILE_SUBDOMAINS=abcd
MAP_TILE_MAX_ZOOM=20
